<Window x:Class="Reverie.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Reverie.Gui.Controls"
        xmlns:local="clr-namespace:Reverie.Gui"
        Title="Reverie"
        Height="740" Width="1180"
        MinHeight="560" MinWidth="920"
        Background="#FFF3F3F3"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/Reverie.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CardHover" Color="#FFF6F6F6"/>
        <SolidColorBrush x:Key="Stroke" Color="#FFE5E5E5"/>
        <SolidColorBrush x:Key="StrokeStrong" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="Fg" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="FgSecondary" Color="#FF5D5D5D"/>
        <SolidColorBrush x:Key="FgTertiary" Color="#FF8A8A8A"/>
        <SolidColorBrush x:Key="Accent" Color="#FF0067C0"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#FFE8F1FB"/>
        <SolidColorBrush x:Key="Danger" Color="#FFC42B1C"/>
        <SolidColorBrush x:Key="ControlBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ControlStroke" Color="#FF8A8A8A"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="FloatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#FFE0E0E0"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="6"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource FgSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TogglePill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/Reverie.png" Width="28" Height="28"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Reverie" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Margin="14,0,0,0" MinWidth="150"
                          ItemsSource="{Binding Layouts}"
                          SelectedItem="{Binding SelectedLayout}"
                          DisplayMemberPath="Name"
                          VerticalAlignment="Center"
                          ToolTip="选择声道布局"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleButton}" Content="加载预设" Command="{Binding LoadPresetCommand}"
                        Margin="0,0,8,0" ToolTip="从 JSON 文件加载布局与路由"/>
                <Button Style="{StaticResource SubtleButton}" Content="保存预设" Command="{Binding SavePresetCommand}"
                        Margin="0,0,8,0" ToolTip="导出当前布局与路由为 JSON"/>
                <Button Style="{StaticResource SubtleButton}" Content="重置布局" Command="{Binding ResetLayoutCommand}"
                        Margin="0,0,8,0" ToolTip="恢复当前布局的默认坐标与映射"/>
                <ToggleButton Style="{StaticResource TogglePill}"
                              IsChecked="{Binding IsRunning, Mode=OneWay}"
                              Command="{Binding ToggleEngineCommand}"
                              Content="{Binding EngineToggleText}"
                              ToolTip="启动 / 停止实时路由"/>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" MinWidth="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏 -->
            <ScrollViewer Grid.Column="0" Margin="0,0,12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="音频源" Style="{StaticResource SectionTitle}"/>
                        <ComboBox ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="DisplayLine"/>
                        <TextBlock Text="选择音频捕获源"
                                   Foreground="{StaticResource FgTertiary}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="L" Foreground="{StaticResource FgTertiary}" FontSize="11" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LevelL, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Text="R" Foreground="{StaticResource FgTertiary}" FontSize="11" VerticalAlignment="Center" Margin="6,0"/>
                            <ProgressBar Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding LevelR, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="前置设备" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="FL · FR · FC · LFE" Foreground="{StaticResource FgTertiary}"
                                   FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding FrontDevice}"
                                  DisplayMemberPath="DisplayLine"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SwapFrontText}"
                                       Foreground="{StaticResource FgSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}"
                                    Content="⇄ 左右对调" Command="{Binding ToggleSwapFrontCommand}"
                                    Padding="12,6" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                        Visibility="{Binding HasSurround, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="环绕设备" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="SL · SR · RL · RR" Foreground="{StaticResource FgTertiary}"
                                       FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SurroundDevice}"
                                  DisplayMemberPath="DisplayLine" Margin="0,4,0,0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SwapSurroundText}"
                                       Foreground="{StaticResource FgSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}"
                                    Content="⇄ 左右对调" Command="{Binding ToggleSwapSurroundCommand}"
                                    Padding="12,6" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                        Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="低音设备" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="LFE · LFE2" Foreground="{StaticResource FgTertiary}"
                                   FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SubDevice}"
                                  DisplayMemberPath="DisplayLine"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                        Visibility="{Binding HasHeight, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="高度设备" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="TFL · TFR · TFC · TRL · TRR" Foreground="{StaticResource FgTertiary}"
                                   FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding HeightDevice}"
                                  DisplayMemberPath="DisplayLine"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SwapHeightText}"
                                       Foreground="{StaticResource FgSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}"
                                    Content="⇄ 左右对调" Command="{Binding ToggleSwapHeightCommand}"
                                    Padding="12,6" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource LinkButton}" Content="刷新设备列表"
                        Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
            </ScrollViewer>

            <!-- 右侧：画布 + 检查器 -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="300" MinWidth="260" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="8,4,8,8">
                            <TextBlock DockPanel.Dock="Left" Text="系统布局" FontSize="14" FontWeight="SemiBold"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="自由移动" Foreground="{StaticResource FgSecondary}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox IsChecked="{Binding FreeMove}"
                                          ToolTip="勾选后可拖拽音箱；取消则仅点击选中"/>
                            </StackPanel>
                            <TextBlock Text="点击选中 · 拖拽调位"
                                       Foreground="{StaticResource FgTertiary}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </DockPanel>
                        <controls:SpeakerLayoutCanvas Grid.Row="1"
                            Speakers="{Binding Speakers}"
                            SelectedSpeaker="{Binding SelectedSpeaker, Mode=TwoWay}"
                            AllowMove="{Binding FreeMove}"
                            SpeakerMovedCommand="{Binding SpeakerMovedCommand, Mode=OneWay}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource FloatCard}"
                        Margin="2,0,0,0" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedSpeaker.ShortLabel}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="{Binding SelectedSpeaker.Label}"
                                               Foreground="{StaticResource FgSecondary}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="选中音箱的输出参数"
                                       Foreground="{StaticResource FgTertiary}" FontSize="11"
                                       Margin="0,2,0,0"/>

                            <Separator Background="{StaticResource Stroke}" Margin="0,14,0,14"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="路由到"
                                           Foreground="{StaticResource FgSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoute.RouteSummary}"
                                           Foreground="{StaticResource FgTertiary}" FontSize="11"
                                           HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            </DockPanel>

                            <DockPanel Margin="0,12,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="音量"
                                           Foreground="{StaticResource FgSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoute.GainText}"
                                           Foreground="{StaticResource Fg}" FontSize="12"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="-24" Maximum="12" TickFrequency="6"
                                    Value="{Binding SelectedRoute.GainDb, Mode=TwoWay}"
                                    ToolTip="输出增益"/>

                            <DockPanel Margin="0,12,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="延时"
                                           Foreground="{StaticResource FgSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedRoute.DelayText}"
                                           Foreground="{StaticResource Fg}" FontSize="12"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="300" TickFrequency="10"
                                    Value="{Binding SelectedRoute.DelayMs, Mode=TwoWay}"
                                    ToolTip="多设备对齐用的延时"/>

                            <CheckBox Content="静音" Margin="0,14,0,0"
                                      IsChecked="{Binding SelectedRoute.Mute, Mode=TwoWay}"
                                      IsEnabled="{Binding HasSelectedSpeaker}"/>

                            <TextBlock Text="左右对调请用左侧设备卡片"
                                       Foreground="{StaticResource FgTertiary}" FontSize="11"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="#08000000" CornerRadius="6"
                                Visibility="{Binding HasSelectedSpeaker, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="在左侧布局图中点击一只音箱"
                                       Foreground="{StaticResource FgTertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="16"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 + 高级 -->
        <Grid Grid.Row="2" Margin="20,12,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{StaticResource FgTertiary}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding EngineStatus}"
                           Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>

            <Expander Grid.Row="1" Header="高级 · 上混"
                      IsExpanded="{Binding ShowAdvanced}" Margin="0,10,0,0">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox Content="立体声上混（仅对立体声源生效，多声道直通）"
                                  IsChecked="{Binding EnableUpmix}"
                                  VerticalAlignment="Center"/>

                        <TextBlock Text="上混矩阵（随布局自动适配）" Foreground="{StaticResource FgSecondary}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,14,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding UpmixGains}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,10,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}"
                                                           FontSize="11" Foreground="{StaticResource FgSecondary}"/>
                                                <TextBlock Text="{Binding ValueText}" FontSize="11"
                                                           Foreground="{StaticResource Fg}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="1.5"
                                                    Value="{Binding Value, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}"
                                    Content="恢复默认" Command="{Binding ResetUpmixCommand}"
                                    VerticalAlignment="Top"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</Window>
